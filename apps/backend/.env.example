# Servidor
PORT=3001
NODE_ENV=development

# Base de datos (Supabase → Settings → Database → Connection string)
DATABASE_URL=postgresql://...

# Meta / WhatsApp Cloud API
META_VERIFY_TOKEN=          # Token inventado por mí, se registra en el panel de Meta
META_ACCESS_TOKEN=          # Token de acceso de la app (temporal en dev, permanente después)
META_PHONE_NUMBER_ID=       # ID del número de prueba (después, del número real)
META_APP_SECRET=            # Para validar la firma X-Hub-Signature-256
WHATSAPP_MODE=real          # 'real' = envía por la Graph API de Meta; 'mock' = solo loguea (dev sin tokens)

# Anthropic
ANTHROPIC_API_KEY=          # Ya disponible
ANTHROPIC_MODEL=claude-haiku-4-5
AI_MODE=real                # 'real' = usa la API de Anthropic; 'mock' = respuesta fija (dev/pruebas)

# Auth
JWT_SECRET=                 # Generar con: openssl rand -hex 64
JWT_EXPIRES_IN=7d

# Panel web (frontend). Orígenes permitidos por CORS en producción (separados por coma).
FRONTEND_URL=               # p. ej. https://bellezabot.vercel.app

# Zona horaria de referencia
DEFAULT_TIMEZONE=America/Mexico_City
