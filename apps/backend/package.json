{
  "name": "bellezabot-backend",
  "version": "0.1.0",
  "description": "Backend de BellezaBot: webhook de WhatsApp, IA de agendamiento y API del panel",
  "private": true,
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --require ./tests/setup-env.js --test --test-concurrency=1",
    "db:setup": "node scripts/db-setup.js",
    "db:test:setup": "node scripts/db-test-setup.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "node-cron": "^4.6.0",
    "pg": "^8.12.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
